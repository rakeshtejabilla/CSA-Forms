# Database Configuration (for direct development run outside Docker)
DATABASE_URL="postgresql://postgres:password@localhost:5433/formbuilder?schema=public&connection_limit=50&pool_timeout=10"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Server Configuration
PORT=3000

# Secret tokens and settings
JWT_SECRET="super-secret-key-change-in-production"
JWT_EXPIRY="15m"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRY="7d"
FILE_UPLOAD_DIR=./uploads

# Seed Default Values (used only on fresh database initialization)
SEED_SUPER_ADMIN_EMAIL="admin@formbuilder.com"
SEED_SUPER_ADMIN_PASSWORD="Password123"
SEED_SUPER_ADMIN_NAME="Super Admin"
SEED_ORG_ADMIN_EMAIL="orgadmin@formbuilder.com"
SEED_ORG_ADMIN_NAME="Org Admin"
SEED_ENUMERATOR_EMAIL="enumerator@formbuilder.com"
SEED_ENUMERATOR_NAME="Enumerator User"
SEED_DEFAULT_ORG_NAME="Default Organization"
SEED_DEFAULT_ORG_CODE="DEFAULT"
SEED_DEFAULT_ORG_EMAIL="contact@default.org"
